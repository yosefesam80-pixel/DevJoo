  <script>
    // -------------------------------------------------------------
    // مشغل الصوت الأساسي
    // -------------------------------------------------------------
    var bgAudio = document.getElementById('bg-audio');
    var musicWidget = document.getElementById('music-widget');
    var musicState = document.getElementById('music-state');
    var isMusicPlaying = false;

    function toggleMusic(forcePlay) {
      if (!bgAudio) return;
      if (forcePlay || !isMusicPlaying) {
        bgAudio.play().then(function() {
          isMusicPlaying = true;
          if (musicWidget) musicWidget.classList.add('playing');
          if (musicState) musicState.innerText = "شغالة الآن 🎶";
        }).catch(function() {});
      } else {
        bgAudio.pause();
        isMusicPlaying = false;
        if (musicWidget) musicWidget.classList.remove('playing');
        if (musicState) musicState.innerText = "متوقفة مؤقتاً";
      }
    }

    // -------------------------------------------------------------
    // العداد الحي
    // -------------------------------------------------------------
    var startDate = new Date(2025, 0, 1, 0, 0, 0);
    function updateCounter() {
      var diff = new Date() - startDate;
      var d = Math.floor(diff / (1000 * 60 * 60 * 24));
      var h = Math.floor((diff / (1000 * 60 * 60)) % 24);
      var m = Math.floor((diff / (1000 * 60)) % 60);
      var s = Math.floor((diff / 1000) % 60);

      var elD = document.getElementById('d-val');
      var elH = document.getElementById('h-val');
      var elM = document.getElementById('m-val');
      var elS = document.getElementById('s-val');

      if (elD) elD.innerText = d;
      if (elH) elH.innerText = (h < 10 ? '0' : '') + h;
      if (elM) elM.innerText = (m < 10 ? '0' : '') + m;
      if (elS) elS.innerText = (s < 10 ? '0' : '') + s;
    }
    setInterval(updateCounter, 1000);
    updateCounter();

    // -------------------------------------------------------------
    // قفل العشاق
    // -------------------------------------------------------------
    function handleLock() {
      showModal("القفل مقفول برباط روحي أبدي 🔒", "مهما بعدت المسافات أو عدت أيام، القفل ده شاهد إن اسمك محفور جوا قلبي ومحدش هيقدر يفك الرباط ده أبداً.");
      shootHearts();
    }

    // -------------------------------------------------------------
    // فويس نوت واتساب
    // -------------------------------------------------------------
    var isVnActive = false;
    function playVoiceNote() {
      var card = document.getElementById('vn-card');
      if (!isVnActive && card) {
        card.classList.add('active');
        isVnActive = true;
        showModal("بصوت قلبي ليكي 🎙️", "عايزك تسمعي صوت دقات قلبي وهي بتقولك: بحبك فوق ما تتخيلي، وانتي أغلى ما ليا في الدنيا كلها.");
        setTimeout(function() {
          card.classList.remove('active');
          isVnActive = false;
        }, 4000);
      }
    }

    // -------------------------------------------------------------
    // بطاقة الكشط (Scratch Card)
    // -------------------------------------------------------------
    var sCanvas = document.getElementById('scratch-board');
    var sCtx = sCanvas ? sCanvas.getContext('2d') : null;
    var isScratching = false;

    function resizeScratch() {
      if (!sCanvas || !sCtx) return;
      sCanvas.width = sCanvas.offsetWidth || 340;
      sCanvas.height = sCanvas.offsetHeight || 145;
      sCtx.fillStyle = '#b5bac4';
      sCtx.fillRect(0, 0, sCanvas.width, sCanvas.height);
      sCtx.fillStyle = '#1e2029';
      sCtx.font = 'bold 13px Cairo, sans-serif';
      sCtx.textAlign = 'center';
      sCtx.fillText('✨ امسحي بصابعك هنا لكشف السر ✨', sCanvas.width / 2, sCanvas.height / 2 + 5);
    }
    window.addEventListener('load', resizeScratch);
    window.addEventListener('resize', resizeScratch);

    function scratchAction(e) {
      if (!isScratching || !sCanvas || !sCtx) return;
      var rect = sCanvas.getBoundingClientRect();
      var clientX = e.clientX || (e.touches && e.touches[0] ? e.touches[0].clientX : 0);
      var clientY = e.clientY || (e.touches && e.touches[0] ? e.touches[0].clientY : 0);
      var x = clientX - rect.left;
      var y = clientY - rect.top;

      sCtx.globalCompositeOperation = 'destination-out';
      sCtx.beginPath();
      sCtx.arc(x, y, 22, 0, Math.PI * 2);
      sCtx.fill();
    }

    if (sCanvas) {
      sCanvas.addEventListener('mousedown', function() { isScratching = true; });
      window.addEventListener('mouseup', function() { isScratching = false; });
      sCanvas.addEventListener('mousemove', scratchAction);

      sCanvas.addEventListener('touchstart', function(e) { isScratching = true; scratchAction(e); }, { passive: true });
      window.addEventListener('touchend', function() { isScratching = false; });
      sCanvas.addEventListener('touchmove', function(e) { scratchAction(e); }, { passive: true });
    }

    // -------------------------------------------------------------
    // استخدام الكوبونات
    // -------------------------------------------------------------
    function useCoupon(id, name) {
      var el = document.getElementById(id);
      if (!el || el.classList.contains('used')) return;
      el.classList.add('used');
      var btn = el.querySelector('button');
      if (btn) btn.innerText = 'تم التفعيل بنجاح ✅';
      shootHearts();
      showModal("تم تفعيل كوبون: " + name, "تم اعتماد طلبك رسميًا! ابعتي له سكرين شوت أو رسالة فورًا وهيتم تنفيذ الكوبون بدون أي تردد! ❤️");
    }

    // -------------------------------------------------------------
    // زر الهروب الميم (Runaway Button)
    // -------------------------------------------------------------
    var fleeBtn = document.getElementById('flee-btn');
    function dodge() {
      if (!fleeBtn) return;
      var x = (Math.random() - 0.5) * 160;
      var y = (Math.random() - 0.5) * 70;
      fleeBtn.style.transform = 'translate(' + x + 'px, ' + y + 'px)';
    }
    function revealTruth() {
      shootHearts();
      showModal("كنت عارف إنك معترفة بالحقيقة! 😂❤️", "أكيد أنا اللي بحبك أكتر، ومفيش أي نقاش في الموضوع ده، وهفضل أحبك أكتر كل يوم!");
    }

    // -------------------------------------------------------------
    // برطمان المشاعر
    // -------------------------------------------------------------
    var reasonsList = [
      "ضحكتك اللي بتنسيني الدنيا وما فيها في ثانية واحدة.",
      "طريقتك لما تكوني متحمصة وبتفضلي تحكي وأنا باصص في عينك ومبسوط.",
      "إنك أماني وراحتي وسط زحمة اليوم والتعب.",
      "طيبة قلبك اللي نادرة ومفيش زيها في الزمن ده.",
      "إنك بتفهميني من نظرة عيني من غير ما أتكلم.",
      "صوتك في أول اليوم اللي بيعدل مزاجي 180 درجة.",
      "غيرتك اللذيذة اللي بتثبت لي قد إيه أنا غالي عندك.",
      "إنك حلمي اللي ربنا حققهولي وراضاني بيه."
    ];

    function drawFromJar() {
      var box = document.getElementById('jar-box');
      if (!box) return;
      box.style.opacity = '0';
      setTimeout(function() {
        box.innerText = '"' + reasonsList[Math.floor(Math.random() * reasonsList.length)] + '"';
        box.style.opacity = '1';
      }, 180);
    }

    // -------------------------------------------------------------
    // افتحيها لما...
    // -------------------------------------------------------------
    var popups = {
      sad: { title: "لو زعلانة مني.. 💔", body: "حقك على راسي من فوق. مقدرش أشوفك زعلانة أو متضايقة مني حتى لو ثانية، مكانتك في قلبي محفوظة ومستنيكي تصالحيني وتكلميني فوراً." },
      tired: { title: "لو يومك كان تقيل ومتعب.. ☕", body: "خدي نفس عميق وافتكري إنك أشطر وأجمل بنوتة. ارتاحي ومتفكريش في حاجة النهاردة، أنا في ضهرك دايماً وكتفي جنبك وقت ما تحتاجي ترتاحي." },
      miss: { title: "لو وحشتك بالليل.. 🌙", body: "بصي للقمر واعرفي إني ببص عليه في نفس اللحظة وبقوله يا بختك إنك بتشوفها، المسافة مجرد أرقام بس قلبي عايش عندك." },
      queen: { title: "لو نسيتي انتي مين عندي.. 👑", body: "انتي أميرتي، والنعمة اللي دعيت بيها ربنا وجاتلي أحلى مما اتمنيت، مفيش حد يقدر يملى مكانك ولا يتقارن بيكي." }
    };

    function openPopup(key) {
      var item = popups[key];
      if (item) showModal(item.title, item.body);
    }

    function showModal(title, body) {
      var t = document.getElementById('m-title');
      var b = document.getElementById('m-body');
      var c = document.getElementById('modal-curtain');
      if (t) t.innerText = title;
      if (b) b.innerText = body;
      if (c) c.classList.add('active');
    }

    function closeModal() {
      var c = document.getElementById('modal-curtain');
      if (c) c.classList.remove('active');
    }

    // -------------------------------------------------------------
    // النجوم والقلوب المتفجرة (Canvas Particles)
    // -------------------------------------------------------------
    var spaceCanvas = document.getElementById('space-canvas');
    var spaceCtx = spaceCanvas ? spaceCanvas.getContext('2d') : null;
    var sw = window.innerWidth;
    var sh = window.innerHeight;

    if (spaceCanvas) {
      spaceCanvas.width = sw;
      spaceCanvas.height = sh;
    }

    window.addEventListener('resize', function() {
      sw = window.innerWidth;
      sh = window.innerHeight;
      if (spaceCanvas) {
        spaceCanvas.width = sw;
        spaceCanvas.height = sh;
      }
    });

    var starParticles = [];
    for (var i = 0; i < 28; i++) {
      starParticles.push({
        x: Math.random() * sw,
        y: Math.random() * sh,
        r: Math.random() * 2 + 1,
        sy: Math.random() * 0.5 + 0.2,
        op: Math.random() * 0.6 + 0.2,
        color: Math.random() > 0.5 ? '#ff2a7a' : '#ffd166'
      });
    }

    function shootHearts() {
      for (var k = 0; k < 20; k++) {
        starParticles.push({
          x: sw / 2 + (Math.random() - 0.5) * 80,
          y: sh / 2 + (Math.random() - 0.5) * 80,
          r: Math.random() * 4 + 2,
          sy: (Math.random() - 0.5) * 6,
          sx: (Math.random() - 0.5) * 6,
          op: 1,
          color: '#ff2a7a',
          burst: true
        });
      }
    }

    function drawSpace() {
      if (!spaceCtx) return;
      spaceCtx.clearRect(0, 0, sw, sh);
      for (var j = 0; j < starParticles.length; j++) {
        var p = starParticles[j];
        spaceCtx.save();
        spaceCtx.globalAlpha = p.op;
        spaceCtx.fillStyle = p.color;
        spaceCtx.shadowBlur = 8;
        spaceCtx.shadowColor = p.color;
        spaceCtx.beginPath();
        spaceCtx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        spaceCtx.fill();
        spaceCtx.restore();

        if (p.burst) {
          p.x += p.sx;
          p.y += p.sy;
          p.op -= 0.025;
          if (p.op <= 0) {
            starParticles.splice(j, 1);
            j--;
          }
        } else {
          p.y -= p.sy;
          if (p.y < -10) { p.y = sh + 10; p.x = Math.random() * sw; }
        }
      }
      requestAnimationFrame(drawSpace);
    }
    drawSpace();
  </script>
